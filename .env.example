# Copiez ce fichier en .env avant `docker compose up`.

# Base de données (catalogue de cartes + statistiques)
POSTGRES_DB=cardgame
POSTGRES_USER=cardgame
POSTGRES_PASSWORD=cardgame
POSTGRES_PORT=5432

# Redis (sessions de jeu en cours, éphémères)
REDIS_PORT=6379

# Serveur
APP_PORT=8080
# Clé de signature des cookies : à remplacer par une valeur aléatoire longue en production.
SESSION_SIGN_KEY=dev-secret-change-me-please-32chars
# Charge le paquet de démonstration en français dans une base vide. À laisser à false en production.
SEED_DEV_DECK=true

# Connexion Discord (facultative). Laissez vide pour masquer le bouton.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/auth/discord/callback

# Connexion Twitch (facultative). Laissez vide pour masquer le bouton et les options de tchat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URL=http://localhost:8080/auth/twitch/callback

# Identifiants Discord autorisés à ouvrir l'administration, séparés par des virgules.
ADMIN_DISCORD_IDS=
