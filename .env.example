# Copiez ce fichier en .env avant `docker compose up`.

# Base de données (catalogue de cartes + statistiques)
POSTGRES_DB=cardgame
POSTGRES_USER=cardgame
POSTGRES_PASSWORD=cardgame
POSTGRES_PORT=5432

# Redis (sessions de jeu en cours, éphémères)
REDIS_PORT=6379

# Serveur
APP_PORT=8080
# Clé de signature des cookies : à remplacer par une valeur aléatoire longue en production.
SESSION_SIGN_KEY=dev-secret-change-me-please-32chars
# Charge le paquet de démonstration en français dans une base vide. À laisser à false en production.
SEED_DEV_DECK=true

# Connexion Discord (facultative). Laissez vide pour masquer le bouton.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URL=http://localhost:8080/auth/discord/callback

# Facultatif : jeton d'un bot Discord. Sert uniquement à retrouver un pseudo depuis un
# identifiant dans l'administration (Discord ne le dit qu'à un bot).
DISCORD_BOT_TOKEN=

# Connexion Twitch (facultative). Laissez vide pour masquer le bouton et les options de tchat.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URL=http://localhost:8080/auth/twitch/callback

# Extension Twitch (facultative) : le panneau sous le stream depuis lequel un spectateur
# écrit une carte, et la paie en bits. Identifiant et secret de l'EXTENSION, pas ceux
# du bouton « Se connecter » : ils viennent de la page de l'extension dans la console.
TWITCH_EXTENSION_CLIENT_ID=
# Le secret tel que la console l'affiche, en base64.
TWITCH_EXTENSION_SECRET=
# Les produits bits déclarés sur l'extension, en paires `sku:montant`. Un reçu est tarifé
# depuis cette liste, jamais depuis ce que le panneau prétend avoir payé.
TWITCH_EXTENSION_PRODUCTS=carte_100:100,carte_500:500

# Derrière un proxy que vous maîtrisez et qui réécrit X-Forwarded-For, passez à true pour
# que les quotas comptent le vrai appelant. À laisser à false si le serveur est joignable
# directement : un client écrit cet en-tête lui-même, et contournerait tous les quotas.
TRUST_PROXY_HEADERS=false

# /metrics est ouvert par défaut (des compteurs, rien d'autre). Renseignez un jeton pour
# exiger `Authorization: Bearer <jeton>` sur un scrape.
METRICS_TOKEN=

# Comptes autorisés à ouvrir l'administration, séparés par des virgules. Les deux listes
# sont indépendantes : un identifiant n'a de sens qu'à côté du service qui l'a émis.
# Côté Twitch, le nom de chaîne est accepté aussi bien que l'identifiant numérique.
ADMIN_DISCORD_IDS=
ADMIN_TWITCH_IDS=
